# ANS Agent configuration
# Claude Code is authenticated separately by the Claude Code CLI (local dev only;
# it is normally NOT available inside the Docker/VPS deploy — there the router
# uses Ollama and any API providers below).

# --- Deploy / network ---
# Bind the UI port ONLY to your VPN interface IP so it is reachable only through
# the VPN (e.g. 10.8.0.1 or 10.66.66.1). 127.0.0.1 = localhost only (SSH tunnel).
ANS_BIND=127.0.0.1
# Host port published on ANS_BIND (container always serves 8080 internally).
# 8899 avoids clashing with panels commonly on 8080.
ANS_HOST_PORT=8899
ANS_HOST=0.0.0.0
ANS_PORT=8080

# --- Local models (Ollama) ---
# In Docker this is overridden to http://ollama:11434 by docker-compose.prod.yml.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- API providers (optional; give the router premium/faster/free options) ---
# OpenRouter — ONE key unlocks Claude, GPT, Gemini + dozens of FREE models (:free).
# Recommended fastest path to good answers. Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Groq — FREE tier, extremely fast. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic (Claude) native API. https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (GPT). https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Google Gemini (has a generous free tier). https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- GitHub (optional) ---
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main

# --- Paths (container defaults; keep under mounted /app/data & /app/workspace) ---
ANS_AUTH_TOKEN_FILE=/app/data/auth.token
ANS_WORKSPACE=/app/workspace
ANS_DB=/app/data/ans.db
ANS_ROUTER_DB=/app/data/router_stats.db
