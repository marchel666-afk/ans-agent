+
+/* ---- conversational agent activity ---- */
+.chat-bar select,.chat-bar input{padding:7px 9px}
+.chat-bar input{width:90px;background:#14181d;color:#dfe3e7;border:1px solid #2a3037;border-radius:7px}
+.agent-activity{display:flex;flex-direction:column;gap:3px;font:12px ui-monospace,SFMono-Regular,monospace}
+.act{padding:3px 0;color:#aeb5be;border-bottom:1px solid #171b20;word-break:break-word}
+.act-plan{color:#cdb3ff}.act-model{color:#8fd0ff}.act-step{color:#e8eaed;font-weight:600}
+.act-tool{color:#f0c674}.act-toolres{color:#7f8994}.act-review{color:#b7c3cf}
+.act-ok{color:#75d78c}.act-warn{color:#e0b050}.act-err,.act-error{color:#e77b7b}.act-info{color:#8c96a2}
+.agent-final{margin-top:10px}
+.final-good{color:#75d78c;font-weight:650;margin-bottom:6px}
+.final-bad{color:#e77b7b;font-weight:650}
+.final-steps{color:#b7c3cf;font-size:13px;line-height:1.6}
+.final-obs{margin-top:8px}.final-obs summary{cursor:pointer;color:#8c96a2;font-size:11px}
