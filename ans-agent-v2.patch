new file mode 100644
index 0000000..4f9b975
--- /dev/null
+++ b/deploy/nginx-agent.conf
@@ -0,0 +1,48 @@
+# ANS Agent — HTTP-блок ЗА твоим SNI-stream роутером nginx.
+# Путь трафика:
+#   Cloudflare (proxied, SSL=Full) → VPS :443 (stream, ssl_preread по SNI)
+#   → 127.0.0.1:10447 (этот server) → 127.0.0.1:8899 (контейнер агента)
+#
+# Устанавливается вместе с ДВУМЯ шагами из deploy/NGINX.md:
+#   (1) запись в stream-карте:  agent.ansservice.ru 127.0.0.1:10447;
+#   (2) этот файл в /etc/nginx/conf.d/  + самоподписанный сертификат.
+#
+# Уникальное имя переменной, чтобы НЕ конфликтовать с уже существующей
+# map $http_upgrade $connection_upgrade в твоём nginx.conf.
+map $http_upgrade $ans_conn_upgrade { default upgrade; '' close; }
+
+server {
+    listen 127.0.0.1:10447 ssl;
+    http2 on;
+    server_name agent.ansservice.ru;
+
+    # Self-signed достаточно: TLS до пользователя терминирует Cloudflare (Full).
+    ssl_certificate     /etc/nginx/ssl/agent.ansservice.ru.crt;
+    ssl_certificate_key /etc/nginx/ssl/agent.ansservice.ru.key;
+    ssl_protocols TLSv1.2 TLSv1.3;
+
+    client_max_body_size 25m;
+
+    # Агент выполняет код на сервере. Доступ закрыт входом по токену в самом
+    # приложении. По желанию добавь ещё Cloudflare Access (вход по email-коду).
+
+    location / {
+        proxy_pass http://127.0.0.1:8899;
+        proxy_http_version 1.1;
+        proxy_set_header Host              $host;
+        proxy_set_header X-Real-IP         $remote_addr;
+        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto https;
+
+        # WebSocket — живая лента шагов агента (/ws/…)
+        proxy_set_header Upgrade    $http_upgrade;
+        proxy_set_header Connection $ans_conn_upgrade;
+
+        # SSE — потоковые ответы чата (/chat): отключаем буферизацию,
+        # держим соединение открытым долго.
+        proxy_buffering    off;
+        proxy_cache        off;
+        proxy_read_timeout 3600s;
+        proxy_send_timeout 3600s;
+    }
+}
